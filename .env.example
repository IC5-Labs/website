# PostgreSQL connection string. On Replit, add a PostgreSQL database and this is set for you.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Auth.js. Generate a secret with: openssl rand -base64 32
AUTH_SECRET=
# Public URL of the site, used for OAuth callbacks and invite links.
AUTH_URL=https://website-ic5labs.replit.app

# OAuth providers. A provider's button appears only when both values are set.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_SLACK_ID=
AUTH_SLACK_SECRET=

# Email that is created as the platform admin on first start.
ADMIN_EMAIL=kit@ic5labs.com

# Local testing only: shows an email-only sign-in. Ignored on Replit deployments.
# ENABLE_DEV_LOGIN=true
